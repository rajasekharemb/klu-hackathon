# Copy to .env.local for local development, and paste the same two values into
# Vercel -> Project -> Settings -> Environment Variables.
#
# Supabase Dashboard -> Project Settings -> API
#   Project URL          -> NEXT_PUBLIC_SUPABASE_URL
#   anon / public key    -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#
# The anon key is meant to be public - Row Level Security is what protects the data.
# NEVER put the service_role key in this file or anywhere in web/.

NEXT_PUBLIC_SUPABASE_URL=https://cxkinufcaefbdmszghtt.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Where "Register Now" sends students. Optional - the app falls back to the KLU
# Google Form if this is unset.
NEXT_PUBLIC_REGISTRATION_FORM_URL=https://forms.gle/nD11BJCkEc1bQAx98
